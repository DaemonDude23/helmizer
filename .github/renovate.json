{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "enabled": true,
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "**/Dockerfile",
        "**/Dockerfile.*"
      ]
    },
    {
      "enabled": true,
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "**/go.mod"
      ]
    },
    {
      "enabled": true,
      "matchManagers": [
        "helm-requirements",
        "helm-values"
      ],
      "matchFileNames": [
        "**/Chart.yaml"
      ]
    },
    {
      "enabled": true,
      "matchManagers": [
        "helmfile"
      ],
      "matchFileNames": [
        "**/helmfile.yaml"
      ]
    },
    {
      "enabled": true,
      "matchManagers": [
        "kustomize"
      ],
      "matchFileNames": [
        "**/kustomization.yaml"
      ]
    },
    {
      "enabled": true,
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "routine maintenance",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "automerge": false,
      "groupName": "Go module maintenance",
      "description": "Go dependency changes need a reviewed Nix vendorHash refresh."
    },
    {
      "matchManagers": [
        "nix"
      ],
      "automerge": false,
      "groupName": "Nix input maintenance"
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "automerge": false,
  "rangeStrategy": "replace",
  "timezone": "America/Los_Angeles",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "automerge": false,
    "groupName": null
  },
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned CI scanner and tool versions",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+_VERSION: (?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+_IMAGE: \\S+?:(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Helm source build and its dependency overrides in Dockerfile.helm",
      "managerFilePatterns": [
        "/(^|/)Dockerfile\\.helm$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>\\S+)\\nARG [A-Z_]+_VERSION=(?<currentValue>\\S+)\\nARG [A-Z_]+_COMMIT=(?<currentDigest>[a-f0-9]{40})",
        "# renovate: datasource=(?<datasource>go) depName=(?<depName>\\S+)\\nARG [A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 3,
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "gomod": {
    "enabled": true
  }
}

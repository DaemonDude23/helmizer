{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "charts: --help",
            "type": "shell",
            "command": "go run . charts --help",
            "options": {
                "cwd": "${workspaceFolder}/src",
                "env": {
                    "CGO_ENABLED": "0"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "charts check (default policy)",
            "type": "shell",
            "command": "go run . charts check ../examples/commonLabels/helmizer.yaml",

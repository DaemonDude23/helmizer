                "cwd": "${workspaceFolder}/src",
                "env": {
                    "CGO_ENABLED": "0"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "charts check (--policy all, yaml)",
            "type": "shell",
            "command": "go run . charts check --policy all --output yaml ../examples/commonLabels/helmizer.yaml",
            "options": {
                "cwd": "${workspaceFolder}/src",
                "env": {
                    "CGO_ENABLED": "0"
                }
            },
            "presentation": {
                "reveal": "always",

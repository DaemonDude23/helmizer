# Builder stage
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.4@sha256:205c7636d74e0ffbe3d007162df7d74f859f5a8c8322dfb9f907977686c126cf AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /build
# Copy go mod files and download dependencies
COPY ./src/go.mod ./src/go.sum ./
RUN go mod download
# Copy the rest of the source code
COPY ./src/ ./
# Build the helmizer binary with CGO disabled for a fully static binary
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -ldflags="-s -w -X main.version=${VERSION}" -o helmizer .

# Helm stage - built from a pinned source commit with the pinned Go toolchain so
# toolchain and x/net security fixes don't wait for upstream Helm images
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.4@sha256:205c7636d74e0ffbe3d007162df7d74f859f5a8c8322dfb9f907977686c126cf AS helm
ARG TARGETOS
ARG TARGETARCH
# renovate: datasource=github-tags depName=helm/helm
ARG HELM_VERSION=v4.3.2
ARG HELM_COMMIT=8346aaa55e7161f7c547212d0a87f01367976727
# renovate: datasource=go depName=golang.org/x/net
ARG X_NET_VERSION=v0.63.0
WORKDIR /helm
RUN git init -q . \
    && git fetch -q --depth 1 https://github.com/helm/helm.git "refs/tags/${HELM_VERSION}" \
    && git checkout -q FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${HELM_COMMIT}"
RUN go get "golang.org/x/net@${X_NET_VERSION}" && go mod tidy
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath \
    -ldflags="-s -w -X helm.sh/helm/v4/internal/version.version=${HELM_VERSION} -X helm.sh/helm/v4/internal/version.gitCommit=${HELM_COMMIT} -X helm.sh/helm/v4/internal/version.gitTreeState=clean" \
    -o /usr/bin/helm ./cmd/helm

# Final stage - alpine instead of scratch so we have a shell (needed for GitHub Actions and CI)
FROM docker.io/library/alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS final
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates git
# Copy the helm binary and helmizer binary to a known location
COPY --from=helm /usr/bin/helm /usr/local/bin/helm
COPY --from=builder /build/helmizer /usr/local/bin/helmizer
# By default, set the binary as the entry point in case you want to run it
ENTRYPOINT ["/usr/local/bin/helmizer"]
